# Copy to .env for local use; production uses /etc/feesconnect.env (0600).
DJANGO_SETTINGS_MODULE=config.settings.dev
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Production also accepts Render generateValue (base64-encoded 32 random bytes).
DJANGO_SECRET_KEY=replace-with-a-random-secret-of-at-least-50-characters
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
SITE_URL=http://127.0.0.1:8000
# Production only: postgresql://feesconnect:URL_ENCODED_PASSWORD@127.0.0.1:5432/feesconnect
# Omit DATABASE_URL for local SQLite.
REDIS_URL=redis://127.0.0.1:6379/0
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=
# Paths default to ./staticfiles and ./private; never expose private through Nginx.
# STATIC_ROOT=/var/www/feesconnect/static
# PRIVATE_ROOT=/var/lib/feesconnect/private
PAYMENTS_ENABLED=false
PAYMENT_ENVIRONMENT=test
# Register real sandbox accounts with each provider before supplying credentials.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PARTNER_ID=
# Add per-school Paynow keys and reference their variable names in MerchantAccount.
PAYNOW_SCHOOL_KEY=
# Microsoft 365: mailbox must exist; app requires Exchange SMTP.SendAsApp and consent.
EMAIL_HOST_USER=support@feesconnect.com
DEFAULT_FROM_EMAIL=FeesConnect <support@feesconnect.com>
SUPPORT_EMAIL=support@feesconnect.com
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# SMTP host= smtp.office365.com; port=587; STARTTLS always enabled.
# EMAIL_HOST_PASSWORD is intentionally unused: this implementation requires OAuth2.
SENTRY_DSN=
# Curated support assistant is available immediately; no external AI account needed.
CHAT_PROVIDER=faq
# Reserved for a future provider adapter; no network call uses these by default.
CHAT_API_URL=
CHAT_API_KEY=

# Render: use the Docker Blueprint; see docs/RENDER.md for existing-service setup.
# Production SITE_URL must be HTTPS; Render's allocated URL is detected on web.
# Explicitly share SITE_URL with workers, especially after adding your custom domain.
CSRF_TRUSTED_ORIGINS=https://feesconnect.com,https://www.feesconnect.com
# Enable only behind your own Nginx that overwrites X-Real-IP; leave false on Render.
TRUST_PROXY_HEADERS=false
# Container launcher honours Render PORT; outside Render this defaults to 8000.
# PORT=8000
WEB_CONCURRENCY=2
CELERY_WORKER_CONCURRENCY=1
STARTUP_TIMEOUT=120
