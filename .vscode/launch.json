{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FeesConnect Django",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": [
        "runserver",
        "127.0.0.1:8000"
      ],
      "django": true,
      "env": {
