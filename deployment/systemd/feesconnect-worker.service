[Unit]
Description=FeesConnect Celery worker
After=network.target redis-server.service postgresql.service
[Service]
User=feesconnect
Group=feesconnect
WorkingDirectory=/srv/feesconnect/current
EnvironmentFile=/etc/feesconnect.env
ExecStart=/srv/feesconnect/current/.venv/bin/celery -A config worker --loglevel=INFO --concurrency=2
Restart=on-failure
PrivateTmp=true
NoNewPrivileges=true
UMask=0077
[Install]
WantedBy=multi-user.target
