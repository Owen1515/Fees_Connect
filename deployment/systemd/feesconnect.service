[Unit]
Description=FeesConnect Gunicorn
After=network.target postgresql.service redis-server.service
[Service]
User=feesconnect
Group=www-data
WorkingDirectory=/srv/feesconnect/current
EnvironmentFile=/etc/feesconnect.env
RuntimeDirectory=feesconnect
RuntimeDirectoryMode=0750
UMask=0007
ExecStart=/srv/feesconnect/current/.venv/bin/gunicorn config.wsgi:application --workers 3 --bind unix:/run/feesconnect/gunicorn.sock --timeout 60 --access-logfile -
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
PrivateTmp=true
NoNewPrivileges=true
[Install]
WantedBy=multi-user.target
